<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_pastel"
    tools:context=".activity_app.nickname.NicknameActivity">

    <!-- Action Bar -->
    <FrameLayout
        android:id="@+id/layoutActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/actionBar"
            layout="@layout/layout_actionbar" />
    </FrameLayout>

    <!-- Input Field (Read-only) -->
    <EditText
        android:id="@+id/edtInputName"
        android:layout_width="0dp"
        android:layout_marginHorizontal="10dp"
        android:layout_height="80dp"
        android:paddingStart="30dp"
        android:paddingEnd="10dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_input"
        android:hint="@string/my_name"
        android:textColorHint="#181717"
        android:paddingHorizontal="20dp"
        android:textSize="18sp"
        android:textColor="@color/dark_purple"
        android:fontFamily="@font/roboto_regular"
        android:inputType="text"
        android:maxLines="1"
        android:maxLength="15"
        android:focusable="false"
        android:clickable="false"
        android:elevation="5dp"
        app:layout_constraintTop_toBottomOf="@id/layoutActionBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RecyclerView for Nickname List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNicknames"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="-5dp"
        android:layout_marginBottom="20dp"
        android:clipToPadding="false"
        android:paddingVertical="10dp"
        app:layout_constraintTop_toBottomOf="@id/edtInputName"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_nickname" />

</androidx.constraintlayout.widget.ConstraintLayout>

